{
	"name": "parse-ansi",
	"type": "commonjs",
	"main": "index.js",
	"version": "1.0.4",
	"description": "🤖  Parse ANSI text into an array of ansi-tags and text-chunks.",
	"license": "MIT",
	"repository": "F1LT3R/parse-ansi",
	"author": {
		"name": "F1LT3R",
		"email": "al@pwn.io",
		"url": "https://f1lt3r.io"
	},
	"scripts": {
		"test": "xo && yarn run cover",
		"unit": "ava",
		"xo-fix": "xo --fix",
		"watch": "ava --watch",
		"cover": "nyc --reporter=lcov --reporter=html --reporter=text ava",
		"coveralls": "cat ./coverage/lcov.info | ./node_modules/.bin/coveralls -v",
		"postinstall": "simple-git-hooks"
	},
	"simple-git-hooks": {
		"pre-commit": "yarn test"
	},
	"files": [
		"index.js",
		"ansi-seqs-to-ansi-tags.js",
		"ansi-tags-to-decorator-names.js"
	],
	"keywords": [
		"ansi",
		"parse",
		"parser",
		"escape",
		"sequence",
		"chalk",
		"color",
		"open",
		"close",
		"style",
		"character"
	],
	"dependencies": {
		"ansi-regex": "^6.3.0",
		"array-uniq": "^3.0.0",
		"deepmerge": "^4.3.1",
		"strip-ansi": "^7.2.0",
		"super-split": "^1.1.1"
	},
	"devDependencies": {
		"ava": "^8.0.1",
		"chalk": "^6.0.0",
		"coveralls": "^3.1.1",
		"nyc": "^18.0.0",
		"simple-git-hooks": "^2.14.0",
		"xo": "^4.0.0"
	},
	"nyc": {
		"reporter": [
			"lcov",
			"text"
		]
	},
	"xo": {
		"semicolon": false,
		"rules": {
			"no-console": 1,
			"space-before-function-paren": 0,
			"unicorn/prefer-module": 0,
			"unicorn/no-for-each": 0,
			"unicorn/prefer-at": 0,
			"unicorn/name-replacements": 0,
			"unicorn/prefer-node-protocol": 0,
			"unicorn/prefer-else-if": 0,
			"unicorn/prefer-spread": 0,
			"unicorn/prefer-unicode-code-point-escapes": 0
		}
	},
	"ava": {
		"failFast": true
	}
}
